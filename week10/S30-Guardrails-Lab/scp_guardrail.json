{  
  "Version": "2012-10-17",  
  "Statement": [  
    {  
      "Sid": "RestrictRegionHopping",  
      "Effect": "Deny",  
      "Action": "*",  
      "Resource": "*",  
      "Condition": {  
        "StringNotEquals": {  
          "aws:RequestedRegion": [  
            "us-east-1"  
          ]  
        }  
      }  
    }  
  ]  
}
